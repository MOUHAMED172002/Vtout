# Database
MYSQL_DATABASE_URL=mysql://root:@localhost:3306/eshop_db

# Clerk Auth (legacy — vérifier si encore utilisé, Better Auth semble l'avoir remplacé)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Payment & Email
# Clé secrète FedaPay (celle qui commence par sk_live_... ou sk_sandbox_...).
# FEDAPAY_SECRET_KEY est le nom lu par server/services/fedapayService.js
# (utilisé pour TOUS les paiements : commandes, badge vendeur, réversement
# livreur) — FEDAPAY_SECRET est un ancien nom encore accepté en repli.
FEDAPAY_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxx
# 'live' pour appeler l'API de production FedaPay (api.fedapay.com) avec une
# clé sk_live_... — sans cette ligne (ou avec toute autre valeur), le serveur
# appelle l'API sandbox (sandbox-api.fedapay.com), même avec une clé live.
FEDAPAY_ENV=live
# Secret de signature webhook FedaPay (format wh_live_...), utilisé pour
# vérifier x-fedapay-signature — voir paymentController.js.
FEDAPAY_WEBHOOK_SECRET=wh_live_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Monitoring (optionnel — no-op tant que non défini, voir sentryService.js)
SENTRY_DSN=

# Server Config
PORT=3000
FRONTEND_URL=http://localhost:5173
SUPPLIER_PORTAL_URL=http://localhost:5174
